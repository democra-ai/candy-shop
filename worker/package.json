{
  "name": "candy-shop-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Candy Shop backend on Cloudflare Workers (Hono + D1)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ./wrangler.toml",
    "deploy": "wrangler deploy --config ./wrangler.toml",
    "d1:migrate": "wrangler d1 migrations apply candy-shop-db --remote --config ./wrangler.toml",
    "d1:migrate:local": "wrangler d1 migrations apply candy-shop-db --local --config ./wrangler.toml",
    "types": "wrangler types --config ./wrangler.toml"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "stripe": "^18.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250121.0",
    "typescript": "~5.9.3",
    "wrangler": "^4.82.2"
  }
}
