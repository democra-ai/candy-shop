{
  "rewrites": [
    {
      "source": "/api/payment/config",
      "destination": "/api/health"
    },
    {
      "source": "/api/invoke/:skillId/stats",
      "destination": "/api/invoke/:skillId/manifest"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/)(?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-Payment, stripe-signature"
        }
      ]
    }
  ]
}
