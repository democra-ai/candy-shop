# Hashed build assets are content-addressed (filename changes when content
# changes), so they can be cached forever. This makes repeat visits fast.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The HTML shell must never be cached — it's the entrypoint that references
# the latest hashed asset filenames. Caching it would pin users to a stale
# build that points at deleted assets.
/index.html
  Cache-Control: no-cache, must-revalidate
/404.html
  Cache-Control: no-cache, must-revalidate
