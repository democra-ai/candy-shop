VITE_SUPABASE_URL=YOUR_SUPABASE_URL_HERE
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# OpenCode Server (optional Basic Auth)
# VITE_OPENCODE_URL=https://tao-shen-opencode.hf.space
# VITE_OPENCODE_USERNAME=opencode
# VITE_OPENCODE_PASSWORD=YOUR_PASSWORD_HERE

# ── Payment Configuration ──────────────────────────────────

# Payment API URL (defaults to /api via Vite proxy → localhost:3001)
# VITE_PAYMENT_API_URL=/api

# Stripe (server-side — set in server/.env)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase service role (server-side — for payment record writes)
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# x402 Protocol (agent-native payments)
# X402_RECEIVER_ADDRESS=0x...  (your USDC receiving wallet)
# X402_NETWORK=base-sepolia     (base-sepolia | base | ethereum)
