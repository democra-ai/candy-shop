VITE_SUPABASE_URL=YOUR_SUPABASE_URL_HERE
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# OpenCode Server (optional Basic Auth)
# VITE_OPENCODE_URL=https://tao-shen-opencode.hf.space
# VITE_OPENCODE_USERNAME=opencode
# VITE_OPENCODE_PASSWORD=YOUR_PASSWORD_HERE

# ── Payment Configuration ──────────────────────────────────
#
# Payments are handled in two places depending on deployment:
#   • Vercel Functions → env vars go on Vercel project settings
#                        (files under /api use process.env.*)
#   • Express server   → env vars go in server/.env
#                        (see /server/README or routes under /server)
#
# Frontend only needs VITE_PAYMENT_API_URL if the API lives elsewhere.
# ───────────────────────────────────────────────────────────

# Payment API URL (defaults to /api via Vite proxy → localhost:3001)
# VITE_PAYMENT_API_URL=/api

# ── Stripe (server-side) ──────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys (test mode)
# STRIPE_SECRET_KEY=sk_test_...
#
# STRIPE_WEBHOOK_SECRET is generated when you register a webhook endpoint:
#   1. In Stripe dashboard → Developers → Webhooks → Add endpoint
#   2. Endpoint URL: https://<your-domain>/api/webhook/stripe
#   3. Events: checkout.session.completed
#   4. Copy the signing secret (whsec_...) here
# For local dev: `stripe listen --forward-to localhost:3001/api/webhook/stripe`
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Supabase service role (server-side) ───────────────────
# Required for payment writes (purchases, entitlements tables).
# Supabase dashboard → Settings → API → service_role key (NOT anon key).
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── x402 Protocol (agent-native payments, optional) ───────
# X402_RECEIVER_ADDRESS=0x...  (your USDC receiving wallet)
# X402_NETWORK=base-sepolia     (base-sepolia | base | ethereum)
